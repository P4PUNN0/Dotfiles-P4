{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "$HOME/.config/fastfetch/ascii.txt",
    "type": "file",
    "color": {
      "1": "cyan"
    },
    "padding": {
      "top": 0,
      "right": 3
    }
  },
  "display": {
    "separator": ": "
  },
  "modules": [
    {
      "type": "break"
    },
    {
      "type": "break"
    },
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "host",
      "key": "Hostname"
    },
    {
      "type": "kernel",
      "key": "Kernel Release"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "wm",
      "key": "WM"
    },
    {
      "type": "packages",
      "key": "Packages"
    },
    {
      "type": "memory",
      "key": "RAM"
    },
    {
      "type": "cpu",
      "key": "Processor"
    },
    {
      "type": "gpu",
      "key": "GPU"
    },
    {
      "type": "disk",
      "key": "Root",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "Battery"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "break"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}